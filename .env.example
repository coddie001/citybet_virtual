# CityBet Virtuals - Environment Configuration
# Copy this to .env and fill in your values
# Load with: set -o allexport; source .env; set +o allexport

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:Abc123!!!@localhost:5432/citybet_virtuals

# ── API Settings ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── GFR Simulation ───────────────────────────────────────────
GFR_MAX_STEPS=3001
GFR_HEADLESS=true

# ── Video Rendering ───────────────────────────────────────────
VIDEO_FPS=10
GIF_SCALE=0.75
RENDER_GIF=true
RENDER_HIGHLIGHTS=true

# ── Worker ───────────────────────────────────────────────────
# How long (seconds) the worker sleeps between queue checks
WORKER_POLL_INTERVAL=60
